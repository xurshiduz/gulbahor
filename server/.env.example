NODE_ENV=development
PORT=3100
# Web manzili (CORS va cookie uchun). Dev'da Vite proksi ishlatiladi.
WEB_ORIGIN=http://localhost:5190

# PostgreSQL. Ilova superuser bo'lmagan rol bilan ulanadi: superuser RLS'ni chetlab o'tadi.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=erp_app
DB_PASSWORD=
DB_NAME=erp
DB_TEST_NAME=erp_test

# Rasmlar saqlanadigan papka. Yozilmasa — server yonidagi `uploads`. Zaxira nusxaga shu papka ham kiradi.
# UPLOADS_DIR=/var/lib/erp/uploads

# Kamida 32 belgi, tasodifiy
JWT_SECRET=

# `npm run seed` uchun namunaviy biznes egasi (faqat lokal ishlab chiqish)
SEED_OWNER_LOGIN=admin
SEED_OWNER_PASSWORD=admin12345
